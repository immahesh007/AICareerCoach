# Root .env.example — not used by docker-compose directly.
# All backend env vars are loaded from backend/.env via env_file.
# The two vars below are overridden in docker-compose.yml automatically:
#
#   DATABASE_URL  → uses the 'db' service hostname instead of localhost
#   OLLAMA_BASE_URL → uses host.docker.internal to reach Ollama on your machine
#
# To get started:
#   cp backend/.env.example backend/.env   # fill in real AWS / JWT values
#   docker compose up --build
#
# Run DB migrations after first boot:
#   docker compose exec backend python -c "
#     import asyncio, asyncpg, glob
#     async def run():
#         conn = await asyncpg.connect('postgresql://postgres:password@localhost:5432/aicareercoach')
#         for f in sorted(glob.glob('migrations/*.sql')):
#             await conn.execute(open(f).read())
#         await conn.close()
#     asyncio.run(run())
#   "