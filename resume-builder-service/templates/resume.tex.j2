\documentclass[<< font_size | default('11pt') >>,a4paper]{article}

%% ─── Page geometry ──────────────────────────────────────────────────────────
<% set m = margin_size | default('normal') %>
<% if m == 'tight' %>
\usepackage[a4paper, top=0.35in, bottom=0.35in, left=0.47in, right=0.47in]{geometry}
<% elif m == 'none' %>
\usepackage[a4paper, top=0.15in, bottom=0.15in, left=0.24in, right=0.24in]{geometry}
<% else %>
\usepackage[a4paper, top=0.65in, bottom=0.65in, left=0.75in, right=0.75in]{geometry}
<% endif %>

<% set bs = bullet_style | default('dash') %>
<% if bs == 'dot' %>
<%   set bullet_label = '\\textbullet' %>
<% elif bs == 'arrow' %>
<%   set bullet_label = '$\\rightarrow$' %>
<% elif bs == 'diamond' %>
<%   set bullet_label = '$\\diamond$' %>
<% else %>
<%   set bullet_label = '--' %>
<% endif %>

<% set sp = spacing | default('normal') %>
<% if sp == 'compact' %>
<%   set section_vspace = '4pt' %>
<%   set item_vspace = '0pt' %>
<%   set topsep_val = '0pt' %>
<%   set between_entry = '2pt' %>
<% else %>
<%   set section_vspace = '7pt' %>
<%   set item_vspace = '2pt' %>
<%   set topsep_val = '0pt' %>
<%   set between_entry = '4pt' %>
<% endif %>

%% ─── XeLaTeX Unicode + emoji font (macOS → Apple Color Emoji, Linux/Docker → Noto) ──
\usepackage{fontspec}
<% set ff = font_family | default('TeX Gyre Heros') %>
\setmainfont{<< ff >>}
\IfFontExistsTF{Apple Color Emoji}{%
  \newfontfamily\emojifont{Apple Color Emoji}%
  \newcommand{\ei}[1]{{\emojifont #1}}%
}{%
  \IfFontExistsTF{Noto Color Emoji}{%
    \newfontfamily\emojifont{Noto Color Emoji}[Renderer=HarfBuzz]%
    \newcommand{\ei}[1]{{\emojifont #1}}%
  }{%
    \newcommand{\ei}[1]{#1}% graceful fallback: no colour emoji
  }%
}

%% ─── Typography + layout packages ───────────────────────────────────────────
\usepackage{microtype}
\usepackage{enumitem}
\usepackage{hyperref}
\hypersetup{hidelinks, colorlinks=false}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

%% ─── Section header command ─────────────────────────────────────────────────
\newcommand{\ressection}[2]{%
  \vspace{<< section_vspace >>}%
  \noindent{\large\bfseries \ei{#1}~#2}%
  \par\nobreak\vspace{-5pt}%
  \noindent\rule{\linewidth}{0.5pt}%
  \par\nobreak\vspace{3pt}%
}

%% ─── Entry header (left bold + right text, same line) ───────────────────────
\newcommand{\entryrow}[2]{%
  \noindent\textbf{#1}\hfill #2%
}

%% ─── Entry sub-row (left italic + right text, same line) ────────────────────
\newcommand{\subrow}[2]{%
  \noindent\textit{#1}\hfill #2%
}

\begin{document}
\pagestyle{empty}

%% ═══════════════════════════════════════════════════════════════════════════
%%  HEADER
%% ═══════════════════════════════════════════════════════════════════════════
\begin{center}
  {\LARGE\bfseries << basics.name | e >>}\\[4pt]
  {\small
    <% if basics.email %>\ei{📬}~\href{mailto:<< basics.email >>}{<< basics.email | e >>}<% endif %>
    <% if basics.phone %>\enspace\ei{☎️}~<< basics.phone | e >><% endif %>
    <% if basics.portfolio %>\enspace\ei{🖥️}~\href{<< basics.portfolio >>}{<< basics.portfolio | e >>}<% endif %>
    <% if basics.github %>\enspace\ei{🔗}~GitHub:~<< basics.github | e >><% endif %>
    <% if basics.linkedin %>\enspace\ei{💼}~\href{https://<< basics.linkedin >>}{<< basics.linkedin | e >>}<% endif %>
  }
\end{center}
\vspace{3pt}

%% ═══════════════════════════════════════════════════════════════════════════
%%  SUMMARY
%% ═══════════════════════════════════════════════════════════════════════════
<% if summary %>
\ressection{📝}{Summary}
<< summary | e >>
<% endif %>

%% ═══════════════════════════════════════════════════════════════════════════
%%  SKILLS
%% ═══════════════════════════════════════════════════════════════════════════
<% set has_skills = skillCategories | selectattr('items') | list %>
<% if has_skills %>
\ressection{🖐️}{Skills Summary}
\begin{itemize}[
  itemsep = << item_vspace >>,
  parsep  = 0pt,
  topsep  = << topsep_val >>,
  partopsep = 0pt,
  leftmargin = 0pt,
  label = {}
]
<% for skill in skillCategories %>
<% if skill['items'] %>
  \item \textbf{<< skill.category | e >>:} << skill['items'] | e >>
<% endif %>
<% endfor %>
\end{itemize}
<% endif %>

%% ═══════════════════════════════════════════════════════════════════════════
%%  EXPERIENCE
%% ═══════════════════════════════════════════════════════════════════════════
<% set has_experience = experience | selectattr('company') | list %>
<% if has_experience %>
\ressection{💼}{Experience}
<% for exp in experience %>
<% if exp.company or exp.title %>
\entryrow{<< exp.company | e >>}{<< exp.location | e >>}\\[-4pt]
\subrow{<< exp.title | e >>}{<< exp.duration | e >>}
<% set valid_bullets = exp.bullets | select | list %>
<% if valid_bullets %>
\begin{itemize}[
  itemsep = 0pt,
  parsep  = 0pt,
  topsep  = 1pt,
  partopsep = 0pt,
  leftmargin = 1.4em,
  label = {<< bullet_label >>}
]
<% for bullet in valid_bullets %>
  \item << bullet | e >>
<% endfor %>
\end{itemize}
<% endif %>
<% if not loop.last %>
\par\vspace{<< between_entry >>}
<% endif %>
<% endif %>
<% endfor %>
<% endif %>

%% ═══════════════════════════════════════════════════════════════════════════
%%  PROJECTS
%% ═══════════════════════════════════════════════════════════════════════════
<% set has_projects = projects | selectattr('name') | list %>
<% if has_projects %>
\ressection{🛠️}{Projects}
\begin{itemize}[
  itemsep = 2pt,
  parsep  = 0pt,
  topsep  = 0pt,
  partopsep = 0pt,
  leftmargin = 1.2em,
  label = {<< bullet_label >>}
]
<% for proj in projects %>
<% if proj.name %>
  \item \textbf{<< proj.name | e >>}<% if proj.tags %> (<< proj.tags | e >>)<% endif %><% if proj.description %>: << proj.description | e >><% endif %><% if proj.tech %>\quad\textit{Tech:} << proj.tech | e >><% endif %><% if proj.date %>\quad(<< proj.date | e >>)<% endif %>
<% endif %>
<% endfor %>
\end{itemize}
<% endif %>

%% ═══════════════════════════════════════════════════════════════════════════
%%  PUBLICATIONS
%% ═══════════════════════════════════════════════════════════════════════════
<% set has_publications = publications | selectattr('title') | list %>
<% if has_publications %>
\ressection{📖}{Publications}
\begin{itemize}[
  itemsep = 2pt,
  parsep  = 0pt,
  topsep  = 0pt,
  partopsep = 0pt,
  leftmargin = 1.2em,
  label = {<< bullet_label >>}
]
<% for pub in publications %>
<% if pub.title %>
  \item <% if pub.prefix %>\textbf{<< pub.prefix | e >>:} <% endif %>\textbf{<< pub.title | e >>}<% if pub.tags %> (<< pub.tags | e >>)<% endif %><% if pub.description %>: << pub.description | e >><% endif %><% if pub.tech %>\quad\textit{Tech:} << pub.tech | e >><% endif %><% if pub.date %>\quad(<< pub.date | e >>)<% endif %>
<% endif %>
<% endfor %>
\end{itemize}
<% endif %>

%% ═══════════════════════════════════════════════════════════════════════════
%%  EDUCATION
%% ═══════════════════════════════════════════════════════════════════════════
<% set has_education = education | selectattr('institution') | list %>
<% if has_education %>
\ressection{📚}{Education}
<% for edu in education %>
<% if edu.institution %>
\entryrow{<< edu.institution | e >>}{<< edu.location | e >>}\\[-3pt]
\noindent\textit{<< edu.degree | e >>}<% if edu.gpa %>; GPA: << edu.gpa | e >><% endif %>\hfill << edu.years | e >>\\[2pt]
<% if edu.coursework %>
\noindent\textit{Courses:} << edu.coursework | e >>%
<% endif %>
<% if not loop.last %>
\par\vspace{<< between_entry >>}
<% endif %>
<% endif %>
<% endfor %>
<% endif %>

%% ═══════════════════════════════════════════════════════════════════════════
%%  HONORS & AWARDS
%% ═══════════════════════════════════════════════════════════════════════════
<% set has_awards = awards | selectattr('name') | list %>
<% if has_awards %>
\ressection{🏆}{Honors \& Awards}
<% for award in awards %>
<% if award.name %>
\noindent << award.name | e >>\hfill << award.date | e >>\\
<% endif %>
<% endfor %>
<% endif %>

%% ═══════════════════════════════════════════════════════════════════════════
%%  VOLUNTEER EXPERIENCE
%% ═══════════════════════════════════════════════════════════════════════════
<% set has_volunteer = volunteer | selectattr('org') | list %>
<% if has_volunteer %>
\ressection{🤝}{Volunteer Experience}
<% for vol in volunteer %>
<% if vol.org %>
\entryrow{<< vol.org | e >>}{<< vol.location | e >>}\\[-3pt]
\subrow{<< vol.description | e >>}{<< vol.duration | e >>}
<% if not loop.last %>
\par\vspace{<< between_entry >>}
<% endif %>
<% endif %>
<% endfor %>
<% endif %>

\end{document}
